{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "lsp": true,
  "formatter": true,
  "permission": {
    "edit": "allow",
    "read": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "python3 --version*": "allow",
      "python3 -m pytest*": "allow",
      "pytest*": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "uv *": "allow",
      "uvx *": "allow",
      ".venv/bin/python*": "allow",
      "source .venv/bin/activate*": "allow",
      "pip install*": "ask",
      "python3 -m pip install*": "ask"
    }
  }
}