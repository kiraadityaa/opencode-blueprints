{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "lsp": true,
  "formatter": true,
  "permission": {
    "edit": "allow",
    "read": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "node -v*": "allow",
      "npm test*": "allow",
      "npm run typecheck*": "allow",
      "npm run lint*": "allow",
      "npm run build*": "allow",
      "npm run dev*": "ask",
      "npm start*": "ask",
      "npm install*": "ask",
      "npm add*": "ask",
      "npm publish*": "deny"
    }
  }
}