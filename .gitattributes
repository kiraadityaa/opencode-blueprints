* text=auto

# Normalize line endings for text files
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.meta text eol=lf
*.editorconfig text eol=lf
.gitignore text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf